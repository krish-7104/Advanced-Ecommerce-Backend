// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())

  firstName   String?
  lastName    String?
  email       String  @unique
  password    String?
  phoneNumber String? @unique

  emailVerified Boolean @default(false)
  phoneVerified Boolean @default(false)

  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  addresses  Address[]
  userTokens UserToken[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  cartItems CartItem[]
  orders    Order[]
}

model Address {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  name        String
  phoneNumber String

  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String  @default("India")
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]

  @@index([userId])
}

model UserToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  tokenHash String   @unique
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  level    Int // 0 = Category, 1 = Subcategory
  isActive Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([level])
}

// SPU – DISPLAY ONLY
model Product {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  brand       String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  attributesSchema Json?
  images           String[]
  isActive         Boolean  @default(true)
  isFeatured       Boolean  @default(false)

  variants  ProductVariant[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([categoryId])
}

// SKU – SELLABLE UNIT
model ProductVariant {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  sku        String   @unique
  attributes Json
  price      Decimal  @db.Decimal(10, 2)
  mrp        Decimal? @db.Decimal(10, 2)
  //   mrp = null → no discount
  //   mrp <= price → no discount
  //   mrp > price → discounted product

  stockAvailable Int @default(0)
  stockSold      Int @default(0)

  images   String[]
  isActive Boolean  @default(true)

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([price])
  @@index([stockAvailable])
}

enum CartItemStatus {
  ACTIVE
  SAVED_FOR_LATER
}

model CartItem {
  id        String         @id @default(cuid())
  userId    String
  variantId String
  quantity  Int
  status    CartItemStatus @default(ACTIVE)
  user      User           @relation(fields: [userId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([userId, variantId])
  @@index([userId])
}

model Order {
  id        String @id @default(cuid())
  userId    String
  addressId String

  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  address Address @relation(fields: [addressId], references: [id])

  items    OrderItem[]
  payments Payment[]

  @@index([userId])
}

enum OrderStatus {
  PENDING
  PAID
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  variantId String

  sku        String
  name       String
  attributes Json

  price    Decimal  @db.Decimal(10, 2)
  mrp      Decimal? @db.Decimal(10, 2)
  quantity Int

  order   Order          @relation(fields: [orderId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])
}

model Payment {
  id      String @id @default(cuid())
  orderId String

  stripeIntentId String        @unique
  status         PaymentStatus
  amount         Decimal       @db.Decimal(10, 2)
  currency       String        @default("INR")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

enum PaymentStatus {
  CREATED
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  REFUNDED
}

model AdminUser {
  id       String  @id @default(cuid())
  name     String
  email    String  @unique
  password String
  isActive Boolean @default(true)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  logs AdminAuditLog[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  adminUserTokens AdminUserToken[]
}

model AdminUserToken {
  id        String    @id @default(cuid())
  userId    String
  user      AdminUser @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())
  expiresAt DateTime
}

model Role {
  id          String  @id @default(cuid())
  name        String  @unique // SuperAdmin, Manager, Support
  description String?

  permissions RolePermission[]
  admins      AdminUser[]

  createdAt DateTime @default(now())
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model AdminAuditLog {
  id String @id @default(cuid())

  adminId String
  admin   AdminUser @relation(fields: [adminId], references: [id])

  entity   String //Table Name
  entityId String //Record ID

  action     AuditAction
  beforeData Json?
  afterData  Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([adminId])
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}
